;; One mutation per invariant. `:find` must occur EXACTLY ONCE in `:file` —
;; `tools/check-mutations.cljs` refuses otherwise, because a mutation that
;; landed in a comment or in a second call site produces a red suite that
;; proves nothing.
;;
;; Read the pair before trusting a red: the thing broken and the thing
;; reported must be the same thing.
;;
;; ⚠ THIS TABLE COVERS ONLY `kotoba.shohyo.ifrs` AND THE ONE LINE IT ADDED TO
;; `kotoba.shohyo` (`:declared`). The core's own fold, the accounting
;; equation, the concept vocabulary and `kotoba.shohyo.jp` are NOT mutated
;; here — the README records fourteen and seven mutations respectively for
;; those, run separately. A green table below says nothing about them.
[
 ;; --------------------------------------------------------------------
 ;; the taxlaw discipline: an unread rule must not back a check
 ;; --------------------------------------------------------------------
 {:id :deleted-item-is-requirable
  :invariant "a paragraph the Board deleted cannot make a statement short"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(not= :deleted status)"
  :replace "(not (nil? status))"}

 {:id :unread-scope-is-requirable
  :invariant "an item whose scope was never read cannot back a check"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(not= :reachable-not-read scope-review)"
  :replace "(not= :never-happens scope-review)"}

 {:id :unread-paragraph-is-requirable
  :invariant "an item is requirable only if its own paragraph was read"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(= :read-from-source review)"
  :replace "(not= :never-happens review)"}

 {:id :unverifiable-does-not-block
  :invariant "a declared item with unread scope makes the verdict not-a-pass"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(seq unverifiable) (conj :scope-not-read)"
  :replace "(seq nil) (conj :scope-not-read)"}

 {:id :unread-catalogue-still-answers
  :invariant "if no paragraph is :read-from-source the module refuses to answer"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(filter #(= :read-from-source (:review %))"
  :replace "(filter #(some? (:review %))"}

 {:id :deleted-paragraph-relabelled-live
  :invariant "IAS 1.82(e) is recorded as deleted, not quietly dropped or kept live"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "{:provision \"IAS 1.82(e)\" :label \"[deleted]\" :status :deleted"
  :replace "{:provision \"IAS 1.82(e)\" :label \"[deleted]\" :status :live"}

 ;; --------------------------------------------------------------------
 ;; IAS 1.31 / 1.57 — a minimum list is not a checklist
 ;; --------------------------------------------------------------------
 {:id :every-item-required
  :invariant "only items the chart DECLARES are required; materiality is the entity's"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(into #{} (filter requirable?) declared)"
  :replace "(into #{} (filter requirable?) (keys sofp-items))"}

 {:id :nothing-is-ever-missing
  :invariant "a declared item absent from a currency's statement is reported"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(remove present required)"
  :replace "(remove (constantly true) required)"}

 {:id :missing-items-not-keyed-by-currency
  :invariant "missing-items reports only the currencies that are short"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(when (seq (:missing v))"
  :replace "(when (some? (:missing v))"}

 {:id :wrong-statement-not-caught
  :invariant "an item present on the wrong statement is not presentation"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(not (contains? got want))"
  :replace "(not (contains? got got))"}

 ;; --------------------------------------------------------------------
 ;; IAS 1.60 / 1.61 — the exception, and the clause that survives it
 ;; --------------------------------------------------------------------
 {:id :liquidity-switches-off-ias-1-61
  :invariant "`Whichever method of presentation is adopted` — 1.61 survives 1.60's exception"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find ":holds? (empty? gaps-61)"
  :replace ":holds? true"}

 ;; The first attempt at this one inserted a second `:holds?` into the same
 ;; map literal, so the file stopped READING and the harness scored it
 ;; UNMEASURED rather than killed. A mutation that breaks the reader
 ;; demonstrates the reader.
 {:id :undeclared-method-passes
  :invariant "an undeclared presentation method is answered, not assumed"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find ":holds? false})))"
  :replace ":holds? true})))"}

 {:id :liabilities-need-no-classification
  :invariant "IAS 1.60 asks for current/non-current assets AND liabilities"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(contains? #{:asset :liability} type)"
  :replace "(contains? #{:asset} type)"}

 {:id :equity-must-be-classified
  :invariant "IAS 1.60 says nothing about equity, so equity is not asked for"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "#{:asset :liability} type)"
  :replace "#{:asset :liability :equity} type)"}

 {:id :deferred-tax-may-be-current
  :invariant "IAS 1.56 forbids classifying deferred tax as current"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(and never-current? (= :current cls))"
  :replace "(and never-current? (= :never-happens cls))"}

 ;; --------------------------------------------------------------------
 ;; the chart
 ;; --------------------------------------------------------------------
 {:id :item-type-conflict-allowed
  :invariant "an item whose account type contradicts its article is caught"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(not= type declared-type)"
  :replace "(not= type type)"}

 {:id :deleted-item-accepted-in-a-chart
  :invariant "a chart may not declare a paragraph the Board deleted"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(= :deleted status)"
  :replace "(= :never-happens status)"}

 {:id :current-tax-forced-onto-one-side
  :invariant "IAS 1.54(n) names `liabilities and assets`, so neither side conflicts"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "    :type nil :review :read-from-source\n    :scope-source \"IAS 12\" :scope-review :reachable-not-read}"
  :replace "    :type :liability :review :read-from-source\n    :scope-source \"IAS 12\" :scope-review :reachable-not-read}"}

 ;; --------------------------------------------------------------------
 ;; the conservative answer, and the core's verdict
 ;; --------------------------------------------------------------------
 {:id :core-incompleteness-not-inherited
  :invariant "a statement the core calls short cannot be IAS 1 conformant"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "core-ok? (= :complete (:shohyo/coverage r))"
  :replace "core-ok? (some? (:shohyo/coverage r))"}

 ;; This id first targeted an `(seq verdicts)` guard. It survived, and the
 ;; reason was not a missing test: coverage is `:checked` only when a line
 ;; declared an item, and lines live inside by-currency, so the guard could
 ;; never fire. The dead code is gone; the live invariant is that EVERY
 ;; currency must conform, not merely one.
 {:id :one-conformant-currency-is-enough
  :invariant "every currency must conform, not some — currencies do not mix"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(every? :conformant? (vals verdicts))"
  :replace "(some :conformant? (vals verdicts))"}

 {:id :presented-is-flattering
  :invariant "the convenient boolean gives the conservative answer, not the flattering one"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(true? (:shohyo.ifrs/conformant? (presentation r opts)))"
  :replace "(not (false? (:shohyo.ifrs/conformant? (presentation r opts))))"}

 {:id :not-declared-swallows-unverifiable
  :invariant "a chart declaring only unread-scope items is :checked-and-refused, not :not-declared"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(empty? declared)"
  :replace "(empty? requirable)"}

 {:id :unread-list-counts-instead-of-naming
  :invariant "what was not read is NAMED, the way missing items are"
  :file "src/kotoba/shohyo/ifrs.cljc"
  :find "(str/join \", \" scopes)"
  :replace "(str (count scopes))"}

 ;; --------------------------------------------------------------------
 ;; the one line this work added to the core
 ;; --------------------------------------------------------------------
 {:id :declaration-not-forwarded
  :invariant "the core carries the chart entry onto the line so a module can read its own key"
  :file "src/kotoba/shohyo.cljc"
  :find ":declared entry}))"
  :replace ":declared nil}))"}
]
